<Window x:Class="IPhoneMirror.DriverInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource AppTitle}"
        Icon="pack://application:,,,/iPhoneMirror.Driver;component/Assets/iPhoneMirror.ico"
        Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        Loaded="OnLoaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="DriverWindowChrome" CaptionHeight="58" ResizeBorderThickness="7"
                            CornerRadius="20" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="DeviceItem" TargetType="ListBoxItem" BasedOn="{StaticResource SelectableListItem}">
            <Setter Property="Padding" Value="14,12"/>
        </Style>
    </Window.Resources>

    <Grid>
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}" Padding="24,18,24,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="11"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Image Source="pack://application:,,,/iPhoneMirror.Driver;component/Assets/iPhoneMirror.ico"
                           Width="32" Height="32"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,144,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource AppTitle}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize22}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource AppSubtitle}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource CaptionFontSize}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource DialogActions}" Margin="-4,4,-4,-4"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ComboBox Margin="{StaticResource DialogActionMargin}" x:Name="ThemeComboBox"
                          ItemsSource="{Binding ThemeChoices}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding SelectedTheme}"
                          Width="154" ToolTip="{DynamicResource Appearance}"
                          PreviewMouseLeftButtonDown="OnThemePreviewMouseLeftButtonDown"/>
                <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource ForceDriverCleanup}"
                        Click="OnForceDriverCleanupClick"
                        IsEnabled="{Binding CanInteract}"
                        Visibility="{Binding AdvancedVisibility}"
                        Style="{StaticResource DangerButton}"
                        MinWidth="146" MinHeight="32" Padding="10,5"
                        FontSize="{DynamicResource FontSize11}"/>
                <Button Margin="{StaticResource DialogActionMargin}" Style="{StaticResource IconButton}"
                        Click="OnOpenLogsClick" IsEnabled="{Binding CanInteract}"
                        ToolTip="{DynamicResource OpenLogs}"
                        Visibility="{Binding AdvancedVisibility}">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Open20" FontSize="16"/>
                </Button>
                <Button Margin="{StaticResource DialogActionMargin}" Style="{StaticResource IconButton}"
                        Click="OnRefreshClick" IsEnabled="{Binding CanInteract}"
                        ToolTip="{DynamicResource Refresh}">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="ArrowClockwise20" FontSize="16"/>
                </Button>
            </WrapPanel>

        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Section}" Padding="14">
            <Border.Visibility>
                <Binding Path="AdvancedVisibility"/>
            </Border.Visibility>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="2,0,18,0">
                    <TextBlock Text="{DynamicResource AppleUsbEnvironment}" TextWrapping="Wrap" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding AppleStatusText}" Margin="0,5,0,0"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>
                <StackPanel Grid.Column="2" Margin="18,0">
                    <TextBlock Text="{DynamicResource CaptureFilterDriver}" TextWrapping="Wrap" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding LibUsbStatusText}" Margin="0,5,0,0"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="3" Content="{DynamicResource InstallAppleDevices}"
                        Click="OnInstallAppleSupportClick"
                        IsEnabled="{Binding CanInstallAppleSupport}"
                        MinWidth="150" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.RowSpan="3" Style="{StaticResource Section}" CornerRadius="22" Padding="24,16" Visibility="{Binding SimpleVisibility}" animations:SurfaceMotion.Enabled="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
                <StackPanel MaxWidth="720" HorizontalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource ControlFillBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" animations:SurfaceMotion.Enabled="True">
                        <ui:SymbolIcon Symbol="UsbPlug20" FontSize="26" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <TextBlock Text="{DynamicResource PrepareTitle}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize28}" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="{DynamicResource PrepareDescription}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="24,8,24,12" LineHeight="{DynamicResource BodyLineHeight}"/>
                    <UniformGrid Columns="2" Margin="0,0,-12,12" animations:SurfaceMotion.Enabled="True" animations:SurfaceMotion.Delay="50">
                        <Border Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,12,0">
                            <StackPanel><TextBlock Text="{DynamicResource AppleUsbEnvironment}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding AppleStatusText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource SecondaryFontSize}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="{DynamicResource BodyLineHeight}"/></StackPanel>
                        </Border>
                        <Border Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,12,0">
                            <StackPanel><TextBlock Text="{DynamicResource CaptureFilterDriver}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding LibUsbStatusText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource SecondaryFontSize}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="{DynamicResource BodyLineHeight}"/></StackPanel>
                        </Border>
                    </UniformGrid>
                    <StackPanel MaxWidth="460" animations:SurfaceMotion.Enabled="True" animations:SurfaceMotion.Delay="100">
                        <TextBlock Text="{DynamicResource CurrentDevice}" FontSize="{DynamicResource SecondaryFontSize}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding ConnectedDevices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" DisplayMemberPath="SelectionText"
                                  MinWidth="320" MinHeight="44" IsEnabled="{Binding CanInteract}" AutomationProperties.Name="{DynamicResource CurrentDevice}"
                                  PreviewMouseLeftButtonDown="OnConnectedDevicePreviewMouseLeftButtonDown" SelectionChanged="OnConnectedDeviceSelectionChanged"/>
                        <TextBlock Text="{Binding SelectedDevice.DetailText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource SecondaryFontSize}" Margin="0,6,0,10" TextWrapping="Wrap"/>
                        <Button Content="{DynamicResource InstallAll}" Style="{StaticResource PrimaryButton}" Click="OnQuickInstallClick" IsEnabled="{Binding CanQuickInstall}" MinHeight="40" FontSize="{DynamicResource ButtonFontSize}"/>
                        <Border Margin="0,10,0,0">
                            <StackPanel><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding BusyVisibility}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding OperationStatus}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="{DynamicResource BodyLineHeight}" AutomationProperties.LiveSetting="Polite"/></StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" animations:SurfaceMotion.Enabled="True">
            <Grid.Visibility>
                <Binding Path="AdvancedVisibility"/>
            </Grid.Visibility>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Section}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource AppleDevices}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold"/>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource DeviceItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock ToolTip="{Binding SelectionText}" Text="{Binding SelectionText}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ConnectionText}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding DriverText}" TextWrapping="Wrap" Margin="0,5,0,0"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                                    <TextBlock Grid.Row="2" Text="{Binding DetailText}" ToolTip="{Binding DetailText}" Margin="0,5,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="{DynamicResource CaptionFontSize}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Section}" animations:SurfaceMotion.Enabled="True" animations:SurfaceMotion.RefreshKey="{Binding SelectedDevice.InstanceId}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CurrentDevice}" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding SelectedDevice.DisplayName}"
                                   FontSize="{DynamicResource FontSize20}" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedDevice.ParentStatusText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <Button Content="{DynamicResource ParentManagerTitle}" Click="OnManageParentClick"
                                IsEnabled="{Binding CanManageParent}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource DeviceInstance}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.InstanceId}"
                                   FontFamily="{StaticResource CodeFontFamily}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource ConnectionStatus}" Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,11,12,0" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding SelectedDevice.ConnectionText}"
                                   Margin="0,11,0,0"/>
                        <TextBlock Grid.Row="2" Text="{DynamicResource DriverStatus}" Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,11,12,0" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding SelectedDevice.DriverText}"
                                   Margin="0,11,0,0"/>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock Text="{Binding OperationStatus}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
                        <ProgressBar Height="4" IsIndeterminate="True"
                                     Visibility="{Binding BusyVisibility}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource BorderSoftBrush}"/>
                    </StackPanel>

                    <Grid Grid.Row="4" VerticalAlignment="Top" animations:SurfaceMotion.Enabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding InstallButtonText}" Style="{StaticResource PrimaryButton}"
                                Click="OnInstallClick" IsEnabled="{Binding CanInstallDriver}"/>
                        <Button Grid.Column="2" Content="{DynamicResource Repair}" Click="OnRepairClick"
                                IsEnabled="{Binding CanRepairDriver}"/>
                        <Button Grid.Column="4" Content="{DynamicResource Uninstall}" Style="{StaticResource DangerButton}"
                                Click="OnUninstallClick" IsEnabled="{Binding CanUninstallDriver}"/>
                    </Grid>
                </Grid></ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource DriverChangeNotice}" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Content="{Binding AdvancedButtonText}" Click="OnAdvancedClick"
                        MinHeight="28" Padding="12,4" FontSize="{DynamicResource FontSize11}"/>
                <TextBlock Text="USB · Apple" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource CaptionFontSize}" Margin="12,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="24,18,24,0" Panel.ZIndex="10" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick"
                        AutomationProperties.Name="{DynamicResource Minimize}"
                        ToolTip="{DynamicResource Minimize}">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Subtract20" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="OnMaximizeClick"
                        AutomationProperties.Name="{DynamicResource Maximize}"
                        ToolTip="{DynamicResource Maximize}">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Maximize20" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource TitleBarCloseButton}" Click="OnCloseWindowClick"
                        IsEnabled="{Binding CanInteract}"
                        AutomationProperties.Name="{DynamicResource Close}"
                        ToolTip="{DynamicResource Close}">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="17"/>
                </Button>
            </StackPanel>
    </Grid>
</Window>
